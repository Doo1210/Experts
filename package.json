{
  "name": "digital-employee-demo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": "22.10.0" },
  "volta": { "node": "22.10.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src/demo",
    "format": "prettier --write src scripts vite.config.js vitest.config.js",
    "format:check": "prettier --check src scripts vite.config.js vitest.config.js",
    "check:versions": "node scripts/check-versions.mjs",
    "check:offline": "node scripts/check-offline.mjs",
    "verify": "npm run check:versions && npm run check:offline && npm test && npm run build"
  },
  "dependencies": {
    "element-ui": "2.15.14",
    "jszip": "3.10.1",
    "vue": "2.7.16",
    "vue-router": "3.6.5"
  },
  "devDependencies": {
    "sass": "1.97.3",
    "prettier": "3.9.6",
    "vite": "5.4.21",
    "vite-plugin-vue2": "2.0.3",
    "vitest": "2.1.9",
    "vue-template-compiler": "2.7.16"
  }
}
